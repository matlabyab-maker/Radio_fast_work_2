   <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#CCCCCC"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#FFFDF6" android:padding="2dp"><TextView android:layout_width="match_parent" android:layout_height="32dp" android:text="IRAN RADIO • online RadioBrowser" android:textSize="11sp" android:textStyle="bold" android:textColor="#1268A3" android:gravity="center"/><LinearLayout android:layout_width="match_parent" android:layout_height="34dp"><Button android:id="@+id/iranUp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▲"/><Button android:id="@+id/iranDown" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▼"/></LinearLayout><ListView android:id="@+id/iranList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#FFFFFF" android:divider="#E5DED0" android:dividerHeight="1dp"/></LinearLayout>
   <LinearLayout android:layout_width="54dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#F2F2F2" android:padding="2dp"><TextView android:layout_width="match_parent" android:layout_height="26dp" android:text="kbps" android:textSize="10sp" android:textStyle="bold" android:gravity="center"/><com.fast.radio.VerticalRulerView android:id="@+id/qualityRuler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/><TextView android:id="@+id/qualityValue" android:layout_width="match_parent" android:layout_height="32dp" android:text="24 kbps" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/></LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:orientation="vertical" android:background="#F8FBFF" android:padding="2dp"><LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="SPECIAL • BBC Persian / VOA Persian" android:textColor="#8A5B00" android:textStyle="bold" android:gravity="center"/><Button android:id="@+id/worldButton" android:layout_width="70dp" android:layout_height="26dp" android:text="WORLD"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="58dp"><Button android:id="@+id/persianUp" android:layout_width="34dp" android:layout_height="match_parent" android:text="▲"/><ListView android:id="@+id/persianList" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFFFF"/><Button android:id="@+id/persianDown" android:layout_width="34dp" android:layout_height="match_parent" android:text="▼"/></LinearLayout></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:background="#F3F3F3" android:padding="3dp"><TextView android:id="@+id/nowPlaying" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="No station selected" android:textSize="12sp" android:textColor="#111111" android:gravity="center_vertical"/><Button android:id="@+id/play" android:layout_width="58dp" android:layout_height="match_parent" android:text="PLAY"/><Button android:id="@+id/stop" android:layout_width="58dp" android:layout_height="match_parent" android:text="STOP"/><Button android:id="@+id/record" android:layout_width="58dp" android:layout_height="match_parent" android:text="REC"/><Button android:id="@+id/fav" android:layout_width="48dp" android:layout_height="match_parent" android:text="★"/></LinearLayout>
  <TextView android:id="@+id/usagePerMinute" android:layout_width="match_parent" android:layout_height="24dp" android:text="مصرف واقعی اینترنت • دقیقه 1: 0.000 MB" android:textSize="11sp" android:textColor="#164A7B" android:gravity="center" android:background="#EAF3FF"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:orientation="vertical" android:background="#FFFBE8" android:padding="2dp"><LinearLayout android:layout_width="match_parent" android:layout_height="25dp"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="TV NEWS SUBTITLE" android:textStyle="bold" android:textSize="10sp" android:gravity="center_vertical"/><Button android:id="@+id/tvTickerToggle" android:layout_width="58dp" android:layout_height="25dp" android:text="ON"/><Button android:id="@+id/tvPrev" android:layout_width="42dp" android:layout_height="25dp" android:text="‹"/><Button android:id="@+id/tvNext" android:layout_width="42dp" android:layout_height="25dp" android:text="›"/></LinearLayout><TextView android:id="@+id/tvUpper" android:layout_width="match_parent" android:layout_height="20dp" android:text="TV: BBC Persian • Online" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical"/><TextView android:id="@+id/tvLower" android:layout_width="match_parent" android:layout_height="27dp" android:text="News subtitle / Persian translation when available" android:textSize="11sp" android:gravity="center_vertical"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="vertical" android:background="#F0F7FF"><LinearLayout android:layout_width="match_parent" android:layout_height="24dp"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="NEWS SOURCES" android:textStyle="bold" android:textSize="10sp" android:gravity="center_vertical"/><Button android:id="@+id/newsTickerToggle" android:layout_width="58dp" android:layout_height="24dp" android:text="ON"/><Button android:id="@+id/newsPrev" android:layout_width="42dp" android:layout_height="24dp" android:text="‹"/><Button android:id="@+id/newsNext" android:layout_width="42dp" android:layout_height="24dp" android:text="›"/></LinearLayout><TextView android:id="@+id/newsLower" android:layout_width="match_parent" android:layout_height="28dp" android:text="آفتاب نیوز • آماده" android:textSize="11sp" android:gravity="center_vertical"/></LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/sunLight" android:layout_width="64dp" android:layout_height="64dp" android:text="☀" android:textSize="52sp" android:textColor="#FFD600" android:gravity="center" android:visibility="invisible" android:elevation="20dp"/>
