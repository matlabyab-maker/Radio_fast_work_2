<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootFrame" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="3dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Fast Radio • FINAL 9" android:textSize="20sp" android:textStyle="bold" android:textColor="#111111" android:gravity="center_vertical"/><Button android:id="@+id/onlineSearch" android:layout_width="82dp" android:layout_height="40dp" android:text="SEARCH"/><Button android:id="@+id/equalizerButton" android:layout_width="52dp" android:layout_height="40dp" android:text="EQ"/><Button android:id="@+id/settings" android:layout_width="58dp" android:layout_height="40dp" android:text="SET"/><TextView android:id="@+id/status" android:layout_width="112dp" android:layout_height="match_parent" android:text="Ready" android:textSize="10sp" android:textColor="#555555" android:gravity="center"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5" android:orientation="horizontal">
